# 이 파일을 .env로 복사한 뒤 실제 값을 채웁니다. .env는 저장소에 올리지 않습니다.
# 불러오는 법: node --env-file=.env scripts/run.mjs  (또는 코드가 .env를 직접 읽습니다)

# AI 제공자: claude(기본) | local | mock
AI_PROVIDER=claude

# (선택) 활성 제공자의 모델을 강제로 지정합니다. 비우면 아래 제공자별 기본값을 씁니다.
AI_MODEL=

# 공통 호출 설정
AI_TEMPERATURE=0
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=30000

# --- claude 제공자 ---
CLAUDE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- local 제공자 (Ollama) ---
LOCAL_AI_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen2.5:7b
