# 이 파일을 .env로 복사한 뒤 실제 값을 채웁니다. .env는 저장소에 올리지 않습니다.

# AI 제공자: claude(기본) | openai | local | mock
AI_PROVIDER=claude

# 사용할 모델 이름(제공자에 맞게)
AI_MODEL=claude-sonnet-4-5

# Claude API 키 (AI_PROVIDER=claude 일 때 필요)
ANTHROPIC_API_KEY=

# OpenAI 키 (AI_PROVIDER=openai 일 때 필요)
OPENAI_API_KEY=

# 로컬 모델 엔드포인트 (AI_PROVIDER=local 일 때, 예: Ollama)
LOCAL_AI_URL=http://127.0.0.1:11434
